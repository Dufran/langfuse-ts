# Copy to .env, replace every CHANGE_ME value, then run `task validate`.

# Image versions. Pin floating tags for reproducible deployments if desired.
LANGFUSE_VERSION=4
POSTGRES_VERSION=17
CLICKHOUSE_VERSION=25.12
REDIS_VERSION=7
MINIO_VERSION=latest
TAILSCALE_VERSION=latest
MINIO_MC_VERSION=latest

# Public tailnet URLs. Replace `example-tailnet.ts.net` with your tailnet DNS name.
# Tailscale HTTPS/MagicDNS must be enabled. Port 9090 serves Langfuse's MinIO API.
TS_HOSTNAME=langfuse
TS_AUTHKEY=tskey-auth-CHANGE_ME
NEXTAUTH_URL=https://langfuse.example-tailnet.ts.net
LANGFUSE_S3_PUBLIC_ENDPOINT=https://langfuse.example-tailnet.ts.net:9090

# Langfuse application secrets.
# Generate NEXTAUTH_SECRET and SALT with: openssl rand -base64 32
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_ME
SALT=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false

# PostgreSQL. Use URL-safe alphanumeric credentials because these are embedded in DATABASE_URL.
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=CHANGE_ME_ALPHANUMERIC
POSTGRES_DB=langfuse

# ClickHouse and Redis.
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME_ALPHANUMERIC
REDIS_AUTH=CHANGE_ME_ALPHANUMERIC

# Internal MinIO used by Langfuse for events, media, and optional exports.
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARACTERS
MINIO_BUCKET=langfuse
MINIO_REGION=us-east-1

# Cloudflare R2 destination for ClickHouse and MinIO backups.
# Create the bucket and an R2 API token with Object Read & Write access first.
# Do not include the bucket name or a trailing slash in AWS_S3_ENDPOINT_URL.
AWS_S3_BUCKET_NAME=CHANGE_ME_BACKUP_BUCKET
AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_ACCESS_KEY_ID=CHANGE_ME
AWS_S3_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_SIGNATURE_VERSION=v4

# Optional one-time bootstrap. Leave blank for interactive setup.
# These are only applied when Langfuse initializes an empty database.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
